{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".indexOn": ["email", "phone", "firebaseUid", "role", "cfId"]
    },
    "stores": {
      ".indexOn": ["type", "territoryKey", "ownerUid", "managerUid", "approvalStatus"]
    },
    "orders": {
      ".indexOn": ["createdAt", "distributorId", "asmId", "placedByUid", "cfId", "paymentProofUrl"]
    },
    "auditLogs": {
      ".indexOn": ["createdAt"]
    },
    "productSkus": {
      ".indexOn": ["productId", "sku", "barcode"]
    },
    "notifications": {
      "$uid": {
        ".indexOn": ["createdAt", "read"]
      }
    }
  }
}
